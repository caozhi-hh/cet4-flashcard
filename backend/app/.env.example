# === AI 模型配置（智谱 GLM，走 OpenAI 兼容接口）===
# 不配置 AI_API_KEY 时：AI 记忆口诀 / AI 生成词书不可用，其余功能正常
AI_API_KEY=your_zhipu_api_key
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
AI_MODEL=glm-4-flash

# === AI 接口限流（按登录用户计数，内存滑窗；0 表示不限）===
AI_MNEMONIC_LIMIT=30
AI_WORDBOOK_LIMIT=5
AI_RATE_WINDOW_SECONDS=3600

# === 认证 / 会话 ===
# 默认值即可；自定义域名部署时设置 SITE_URL 以便跨域开发调试
SESSION_COOKIE_NAME=cet4_session
CSRF_COOKIE_NAME=cet4_csrf
SESSION_TTL_DAYS=30
# Secure 策略：auto=按请求协议自动判定（生产 HTTPS 自动开启）；1=强制；0=关闭
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax
SITE_URL=

# === 管理接口令牌 ===
# 配置后才能调用 POST /api/words/init 等管理接口；留空则该接口一律 403
ADMIN_TOKEN=